server {
    listen 80;
    listen [::]:80;
    server_name kampuslms.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kampuslms.example.com;

    root /var/www/kampuslms/public;
    index index.php index.html;

    ssl_certificate /etc/letsencrypt/live/kampuslms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kampuslms.example.com/privkey.pem;

    location ~ ^/(?:\.env|composer\.(?:json|lock)|vendor/|storage/logs/) {
        return 404;
    }

    location ~ /\.(?!well-known) {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param HTTPS on;
    }
}
